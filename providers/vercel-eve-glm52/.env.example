# Secret presented by OpenMinis to this bridge. Generate a long random value.
MINIS_BRIDGE_API_KEY=replace-with-a-long-random-secret

# For local Eve development. On Vercel, Eve/AI Gateway may use Vercel-managed
# identity depending on the deployment configuration. Never commit a real key.
AI_GATEWAY_API_KEY=

# Fail closed when the title-stated promotion window has ended.
# The official changelog says "through August 27"; this UTC boundary is an
# operational guard, not a billing guarantee. Verify $0 usage in AI Gateway.
PROMO_END_AT=2026-08-28T00:00:00.000Z
ALLOW_PAID_AFTER_PROMO=false
